              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<patient name>\",\n  \"age\": 30,\n  \"gender\": \"O\",\n  \"phone\": \"<phone>\",\n  \"address\": \"<address>\",\n  \"medical_history\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
